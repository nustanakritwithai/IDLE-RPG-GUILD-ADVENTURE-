# Generated Godot/editor state; keep source .uid and source-side .import files.
**/.godot/
**/.import/
**/.mono/
**/.vs/
**/.vscode/
**/.DS_Store
**/Thumbs.db
**/__pycache__/
*.pyc

# Runtime profiles, actual player/test saves, logs, private evidence.
**/profiles/
**/userdata/
**/user_data/
**/test-profiles/
**/saves/
**/player_saves/
**/keystores/
**/.tmp/
**/private-evidence/
*.log
*.tmp
*.bak
*.save

# Secrets and signing material. Do not inspect these files to decide inclusion.
.env
.env.*
!.env.example
*.jks
*.keystore
*.key
*.pem
*.p12
*.pfx
*.mobileprovision
**/export_credentials.cfg
**/editor_settings-*.tres
**/credentials.json
**/service-account*.json

# Toolchains, package/build output, cached archives, exported applications.
**/sdk/
**/jdk/
**/tools/
**/node_modules/
**/.gradle/
**/build/
**/builds/
**/artifacts/
**/dist/
**/export_templates/
